# ==============================================================================
# AIAdminHelper - Umgebungsvariablen Template (.env)
# Kopiere diese Datei als .env auf deinen Server oder konfiguriere sie in Coolify.
# ==============================================================================

PORT=3000
APP_URL=https://deine-bot-domain.de

# --- Dashboard & Admin Authentifizierung ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dein_sicheres_passwort
# WICHTIG: JWT_SECRET muss mindestens 32 Zeichen lang sein (für PostgREST)
JWT_SECRET=mindestens_32_zeichen_langes_geheimnis_hier_einfuegen

# --- Bot Einstellungen ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# --- AI API Keys (Mindestens einer ist erforderlich) ---
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Optionale Integrationen ---
# Sellauth (für Channel-Paket-Abfragen)
SELLAUTH_API_KEY=
SELLAUTH_SHOP_ID=
SELLAUTH_SHOP_URL=

# Web-Push Notifications (für Dashboard-Benachrichtigungen)
# Generieren mit: npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ==============================================================================
# DATENBANK - HOSTING OPTIONEN
# ==============================================================================

# --- OPTION A: Self-Hosted (Empfohlen für Coolify) ---
DB_SELF_HOSTED=true
# DATABASE_URL wird von Coolify automatisch bereitgestellt, wenn eine DB verlinkt ist.
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://postgres:dein_db_passwort@db:5432/postgres

# --- OPTION B: Supabase Cloud (Legacy-Modus) ---
# Nur aktiv, wenn DB_SELF_HOSTED nicht auf 'true' gesetzt ist.
SUPABASE_URL=https://xxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
